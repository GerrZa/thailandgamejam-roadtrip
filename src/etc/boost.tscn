[sub_resource type="GDScript" id="GDScript_6phvn"]
script/source = "extends Area2D

var free_time = 0.1
var deleting = false

func _ready() -> void:
	$Line2D.visible = true
	$Line2Dblink.visible = false

func _physics_process(delta: float) -> void:
	if deleting:
		free_time -= delta
	
	if free_time < 0.0:
		queue_free()

func remove():
	$Line2D.visible = false
	$Line2Dblink.visible = true
	
	deleting = true
"


[sub_resource type="GDScript" id="GDScript_e26hg"]
script/source = "extends Area2D

var cutscene3

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	cutscene3 = [\"2-3\",
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"start_cutscene\",
			\"arg\":[]
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]KEEP GOING!!!\",
			\"spr_frame\":SimpleDialog.GRACE_SHOCK,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]HIT THE PEDAL!!!\",
			\"spr_frame\":SimpleDialog.GRACE_SHOCK,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"Car\"),
			\"func\":\"accelerate\",
			\"arg\":[]
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]ARG!!!\",
			\"spr_frame\":SimpleDialog.DAVID_SHOCK,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"Car\"),
			\"func\":\"accelerate\",
			\"arg\":[]
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-55.0]
		},
		{
			\"type\":\"dialogfunc\",
			\"func\":\"clear_dialog\"
		},
		{
			\"type\":\"animation\",
			\"animplayer\":get_tree().current_scene.get_node(\"AnimationPlayer\"),
			\"animname\":\"end\"
		},
		{
			\"type\":\"manipulate\",
			\"node\":Global,
			\"func\":\"change_scene\",
			\"arg\":[preload(\"res://src/level/level3/level_3.tscn\")]
		}
	]
	
	
	connect(\"area_entered\", func(area) : run_cutscene())

func run_cutscene():
	
	print(\"run cutscene\")
	
	SimpleDialog.set_sequence(cutscene3)
	SimpleDialog.execute_sequence(func():
		get_tree().current_scene.get_node(\"AnimationPlayer\").play(\"end\")
		get_tree().current_scene.get_node(\"music_player\").set_target(-55.0)
		
		await get_tree().current_scene.get_node(\"AnimationPlayer\").play(\"end\").animation_finished
		
		Global.change_scene(preload(\"res://src/level/level3/level_3.tscn\"))
		)
"


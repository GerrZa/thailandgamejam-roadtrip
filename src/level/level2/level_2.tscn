[sub_resource type="GDScript" id="GDScript_nygch"]
script/source = "extends Area2D

var cutscene2

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	cutscene2 = [\"2-2\",
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"start_cutscene\",
			\"arg\":[]
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"play\",
			\"arg\":[]
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[color=Dimgray] . . . \",
			\"spr_frame\":SimpleDialog.GRACE_SERIOUS,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"[color=Dimgray] . . . \",
			\"spr_frame\":SimpleDialog.DAVID_SERIOUS,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"Let's not talk about it...\",
			\"spr_frame\":SimpleDialog.GRACE_SERIOUS,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"Y..Ye..Yeah...\",
			\"spr_frame\":SimpleDialog.DAVID_SERIOUS,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"[color=Dimgray] . . . \",
			\"spr_frame\":SimpleDialog.DAVID_SERIOUS,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[color=Dimgray] . . . \",
			\"spr_frame\":SimpleDialog.GRACE_SERIOUS,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"Car\"),
			\"func\":\"accelerate\",
			\"arg\":[]
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"H..Hey.. David!? What are you doing?\",
			\"spr_frame\":SimpleDialog.GRACE_SERIOUS,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"[color=Dimgray] . . . \",
			\"spr_frame\":SimpleDialog.DAVID_SERIOUS,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"Car\"),
			\"func\":\"accelerate\",
			\"arg\":[]
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]DAVID!!!!\",
			\"spr_frame\":SimpleDialog.GRACE_SHOCK,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-35.0]
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]I'M NOT GONNA STAY IN THE WOOD WITH THAT THING, OK!!??!!?!\",
			\"spr_frame\":SimpleDialog.DAVID_SHOCK,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-25.0]
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]ARGG!!!!!!!\",
			\"spr_frame\":SimpleDialog.GRACE_SHOCK,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-15.0]
		},
		{
			\"type\":\"dialogfunc\",
			\"func\":\"clear_dialog\"
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"end_cutscene\",
			\"arg\":[]
		}
	]
	
	
	connect(\"area_entered\", func(area) : run_cutscene())

func run_cutscene():
	
	print(\"run cutscene\")
	
	SimpleDialog.set_sequence(cutscene2)
	SimpleDialog.execute_sequence(func():
		get_tree().current_scene.get_node(\"Car\").accelerate()
		get_tree().current_scene.get_node(\"Car\").accelerate()
		get_tree().current_scene.get_node(\"music_player\").play()
		get_tree().current_scene.get_node(\"music_player\").set_target(-15.0)
		)
"


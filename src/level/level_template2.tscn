[sub_resource type="GDScript" id="GDScript_26xyn"]
script/source = "extends Area2D

var cutscene6

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	cutscene6 = [\"1-6\",
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"start_cutscene\",
			\"arg\":[]
		},###############################################################
		{
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"[color=Dimgray]. . .\",
			\"spr_frame\":SimpleDialog.DAVID_SERIOUS,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[color=Dimgray]. . .\",
			\"spr_frame\":SimpleDialog.GRACE_SERIOUS,
			\"glob\":Vector2(60,120),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"[color=Dimgray]. . .\",
			\"spr_frame\":SimpleDialog.DAVID_SERIOUS,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[color=Dimgray]. . .\",
			\"spr_frame\":SimpleDialog.GRACE_SERIOUS,
			\"glob\":Vector2(60,120),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ ###############################################################
			\"type\":\"dialogfunc\",
			\"func\":\"clear_dialog\"
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"end_cutscene\",
			\"arg\":[]
		}
	]
	
	
	connect(\"area_entered\", func(area) : run_cutscene())

func run_cutscene():
	print(\"run cutscene\")
	
	SimpleDialog.set_sequence(cutscene6)
	SimpleDialog.execute_sequence()
"


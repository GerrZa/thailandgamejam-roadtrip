			\"char\":\"David\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]I'M TRYING!!![/shake]\",
			\"spr_frame\":SimpleDialog.DAVID_SHOCK,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[color=red][shake rate=20.0 level=5 connected=1]WATCH OUT!!![/shake]\",
			\"spr_frame\":SimpleDialog.GRACE_SHOCK,
			\"glob\":Vector2(60,120),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},

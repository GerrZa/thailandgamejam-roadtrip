script/source = "extends Area2D

var cutscene2

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	cutscene2 = [\"3-2\",
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"start_cutscene\",
			\"arg\":[]
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-20.0]
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"You know..\",
			\"spr_frame\":SimpleDialog.GRACE_NORMAL_SPR,
			\"glob\":Vector2(30,120),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-30.0]
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"This feels like some movie I've seen before.\",
			\"spr_frame\":SimpleDialog.GRACE_SMILE_SPR,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"I'm not really sure about the name.\",
			\"spr_frame\":SimpleDialog.GRACE_SMILE_SPR,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"And this feel like we're gonna die if the fuel isn't going to ran out soon.\",
			\"spr_frame\":SimpleDialog.GRACE_NORMAL_SPR,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"Don't worry Grace, It's like.. a bar left!\",
			\"spr_frame\":SimpleDialog.DAVID_SMILE_SPR,
			\"glob\":Vector2(50,220),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-50.0]
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"My instinct said it will ran out before we hit something.\",
			\"spr_frame\":SimpleDialog.DAVID_SMILE_SPR,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player2\"),
			\"func\":\"play\",
			\"arg\":[]
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player2\"),
			\"func\":\"set_target\",
			\"arg\":[-20.0]
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-50.0]
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player2\"),
			\"func\":\"set_target\",
			\"arg\":[-30.0]
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"Police\",
			\"text\":\"[shake rate=20.0 level=5 connected=1][color=red]PULL OVER!!!\",
			\"spr_frame\":SimpleDialog.POLICE_NORMAL,
			\"glob\":Vector2(210,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"Police\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]YOU'RE DRIVING IN A DEADLY SPEED!!!\",
			\"spr_frame\":SimpleDialog.POLICE_NORMAL,
			\"glob\":Vector2(50,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"Police\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]STOP THE CAR!!!\",
			\"spr_frame\":SimpleDialog.POLICE_NORMAL,
			\"glob\":Vector2(50,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"HELP!!! THE BRAKE IS BROKEN!!!\",
			\"spr_frame\":SimpleDialog.DAVID_SHOCK,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"Police\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]STOP PLAYING VICTIM!!!\",
			\"spr_frame\":SimpleDialog.POLICE_NORMAL,
			\"glob\":Vector2(50,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"Police\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]YOUNG PEOPLE THESE DAY ARE SO SHAMELESS...\",
			\"spr_frame\":SimpleDialog.POLICE_NORMAL,
			\"glob\":Vector2(50,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"Police\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]I'M DISGUSTED!!!\",
			\"spr_frame\":SimpleDialog.POLICE_NORMAL,
			\"glob\":Vector2(50,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"Police\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]STOP THE CAR!!!\",
			\"spr_frame\":SimpleDialog.POLICE_NORMAL,
			\"glob\":Vector2(50,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player2\"),
			\"func\":\"set_target\",
			\"arg\":[-15.0]
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-80.0]
		},
		{
			\"type\":\"dialogfunc\",
			\"func\":\"clear_dialog\"
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"end_cutscene\",
			\"arg\":[]
		}
	]
	
	
	connect(\"area_entered\", func(area) : run_cutscene())

func run_cutscene():
	
	print(\"run cutscene\")
	
	SimpleDialog.set_sequence(cutscene2)
	SimpleDialog.execute_sequence(func():
		get_tree().current_scene.get_node(\"music_player\").set_target(-70.0)
		get_tree().current_scene.get_node(\"music_player2\").play()
		get_tree().current_scene.get_node(\"music_player2\").set_target(-15.0)
		)
"


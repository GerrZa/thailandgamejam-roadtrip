[sub_resource type="GDScript" id="GDScript_vuvp6"]
script/source = "extends Area2D

var police_car = preload(\"res://src/level/level3/police_car.tscn\")

func _ready() -> void:
	connect(\"area_entered\", func(area): spawn_police())
	

func spawn_police():
	var car_ins = police_car.instantiate()
	
	if get_tree().current_scene.get_node_or_null(\"Car\"):
		randomize()
		car_ins.position.x = randf_range(50.0, 270.0)
		car_ins.position.y = 320
	else:
		return
	
	get_tree().current_scene.add_child(car_ins)
"


script/source = "extends Node2D

var moving_scale = 2.5
var moving_speed = 0.0

@export var moving = false


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	#ungroupping all moving object
	for i in $move_along.get_children():
		i.add_to_group(\"move_along\")
		i.reparent(self)
		i.visible = false

	var level1_seq1 = [\"3-start\",
		{
			\"type\":\"animation\",
			\"animplayer\":$AnimationPlayer,
			\"animname\":\"start\"
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"play\",
			\"arg\":[]
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-45.0]
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]HELL YEAH!!!\",
			\"spr_frame\":SimpleDialog.DAVID_SMILE_SPR,
			\"glob\":Vector2(180,180),
			\"target\":$main_ui
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"We're finally here!\",
			\"spr_frame\":SimpleDialog.DAVID_SMILE_SPR,
			\"glob\":Vector2(180,180),
			\"target\":$main_ui
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-35.0]
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"We just have to pass through this town and we can finally chillout at...\",
			\"spr_frame\":SimpleDialog.DAVID_SMILE_SPR,
			\"glob\":Vector2(180,180),
			\"target\":$main_ui
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"[wave amp=20.0 freq=5.0 connected=1][color=Royalblue]The Kapt town's hill![/color]\",
			\"spr_frame\":SimpleDialog.DAVID_SMILE_SPR,
			\"glob\":Vector2(180,180),
			\"target\":$main_ui
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]HOOOOOORAYYYY!!!!\",
			\"spr_frame\":SimpleDialog.GRACE_SMILE_SPR,
			\"glob\":Vector2(60,120),
			\"target\":$main_ui
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-25.0]
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"What are we waiting for then? Let's GOOO!!!\",
			\"spr_frame\":SimpleDialog.GRACE_SMILE_SPR,
			\"glob\":Vector2(60,120),
			\"target\":$main_ui
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_target\",
			\"arg\":[-15.0]
		},
		{
			\"type\":\"dialogfunc\",
			\"func\":\"clear_dialog\"
		},
		{
			\"type\":\"manipulate\",
			\"node\":self,
			\"func\":\"end_cutscene\",
			\"arg\":[]
		}
	]
	start_cutscene()
	
	SimpleDialog.set_sequence(level1_seq1)
	SimpleDialog.execute_sequence(func():
		$AnimationPlayer.play(\"start\")
		
		await $AnimationPlayer.animation_finished
		
		end_cutscene()
		get_tree().current_scene.get_node(\"music_player\").play()
		get_tree().current_scene.get_node(\"music_player\").set_target(-15.0)
)
		
# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func _physics_process(delta: float) -> void:
	
	if get_node_or_null(\"Car\"):
		moving_speed = $Car.main_speed
	else:
		moving_scale = lerp(moving_scale, 0.0, 0.03 * Global.time_scale)
		$ambient_player.target_db = -80.0
		$car_driving_ambient.target_db = -80.0
	
	$bg1.autoscroll = Vector2(0, moving_speed * moving_scale * Global.time_scale)
	
	if moving:
		for o in get_tree().get_nodes_in_group(\"move_along\"):
			o.position.y += moving_speed * delta * moving_scale * Global.time_scale
			if o.position.y >= -100:
				o.visible = true
			
			if o.position.y > 650 and String(o.name)[0] != \"m\":
				o.queue_free()
	
	if moving_scale < 0.01 and get_node_or_null(\"Car\") == null:
		get_tree().change_scene_to_file(\"res://src/level/dead_scene/dead_scene.tscn\")

func start_cutscene():
	print(\"start cutscene\")
	moving = false
	$Car.enable_control = false
	$Car.speed = 0.0
	$Car.apply_speed = 0.0
	$Car.disable_camera()

func end_cutscene():
	print(\"end cutscene\")
	moving = true
	$Car.enable_control = true
	$Car.enable_camera()
"


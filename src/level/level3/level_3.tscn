[sub_resource type="AnimationLibrary" id="AnimationLibrary_pess2"]
_data = {
&"RESET": SubResource("Animation_pess2"),
&"start": SubResource("Animation_6phvn")
}

[sub_resource type="GDScript" id="GDScript_afxm8"]
script/source = "extends AudioStreamPlayer

@export var target_db = -15.0
@export var init_db = -80.0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	volume_db = init_db

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _physics_process(delta: float) -> void:
	volume_db = move_toward(volume_db, target_db, 1.0)

func set_target(target):
	target_db = target
"

[sub_resource type="GDScript" id="GDScript_grk6y"]
script/source = "extends AudioStreamPlayer

@export var target_db = -13.0
@export var init_db = -80.0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	playing = false
	volume_db = init_db
	set_target(target_db)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _physics_process(delta: float) -> void:
	#volume_db = lerp(volume_db, target_db, 0.1)
	volume_db = move_toward(volume_db, target_db, 1.0)

func set_target(target):
	target_db = target
"


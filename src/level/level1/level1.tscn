			\"char\":\"Grace\",
			\"text\":\"[shake rate=30.0 level=7 connected=1]ARG!!!!!!!!!!!![/shake]\",
			\"spr_frame\":SimpleDialog.GRACE_SHOCK,
			\"glob\":Vector2(60,120),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"At least we survived that d@mn road.\",
			\"spr_frame\":SimpleDialog.GRACE_NORMAL_SPR,
			\"glob\":Vector2(60,120),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[color=Dimgray]*sigh*\",
			\"spr_frame\":SimpleDialog.GRACE_NORMAL_SPR,
			\"glob\":Vector2(60,120),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"Yeah...\",
			\"spr_frame\":SimpleDialog.DAVID_SHOCK,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"I guess that's it, that's the end of the road.\",
			\"spr_frame\":SimpleDialog.DAVID_NORMAL_SPR,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"Let's head to the forest before it gets dark.\",
			\"spr_frame\":SimpleDialog.DAVID_NORMAL_SPR,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"Yeah...\",
			\"spr_frame\":SimpleDialog.GRACE_NORMAL_SPR,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"By the way, that was crazy!\",
			\"spr_frame\":SimpleDialog.GRACE_SMILE_SPR,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"You sure you're just a beginner?\",
			\"spr_frame\":SimpleDialog.GRACE_SMILE_SPR,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"Didn't I told you that I'm a professional!? HEHEHE~\",
			\"spr_frame\":SimpleDialog.DAVID_SMILE_SPR,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"Ok ok.. \\\"Mr. Professional.\\\" <3\",
			\"spr_frame\":SimpleDialog.GRACE_SMILE_SPR,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ ###############################################################
			\"type\":\"dialogfunc\",
			\"func\":\"clear_dialog\"
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_instrument\",
			\"arg\":[\"none\", -7.0]
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"ambient_player\"),
			\"func\":\"set_target\",
			\"arg\":[\"none\", -70.0]
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"car_driving_ambient\"),
			\"func\":\"set_target\",
			\"arg\":[\"none\", -70.0]
		},
		{
			\"type\":\"animation\",
			\"animplayer\":get_tree().current_scene.get_node(\"AnimationPlayer\"),
			\"animname\":\"end\"
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"end_level\",
			\"arg\":[]
		}
	]
	
	
	connect(\"area_entered\", func(area) : run_cutscene())

func run_cutscene():
	print(\"run cutscene\")
	
	
	SimpleDialog.set_sequence(cutscene7)
	SimpleDialog.execute_sequence(func():
		get_tree().current_scene.start_cutscene()
		get_tree().current_scene.get_node(\"AnimationPlayer\").play(\"end\")
		get_tree().current_scene.get_node(\"music_player\").set_instrument(\"none\", -7.0)
		
		await get_tree().current_scene.get_node(\"AnimationPlayer\").animation_finished
		
		get_tree().current_scene.end_level()
		)
"


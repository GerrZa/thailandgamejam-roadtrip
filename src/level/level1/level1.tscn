script/source = "extends Area2D

var cutscene7

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	cutscene7 = [\"1-7\",
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"start_cutscene\",
			\"arg\":[]
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"music_player\"),
			\"func\":\"set_instrument\",
			\"arg\":[\"half-2\", -7.0]
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[color=Dimgray]! ! !\",
			\"spr_frame\":SimpleDialog.GRACE_SERIOUS,
			\"glob\":Vector2(60,120),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")

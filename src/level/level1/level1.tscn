[sub_resource type="GDScript" id="GDScript_p7x62"]
script/source = "extends Area2D

var cutscene2

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	cutscene2 = [\"1-2\",
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"start_cutscene\",
			\"arg\":[]
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene.get_node(\"radio_ambient\"),
			\"func\":\"set_target\",
			\"arg\":[-20.0]
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"Hey! Why are you speeding!?\",
			\"spr_frame\":SimpleDialog.GRACE_NORMAL_SPR,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"No, I didn't???\",
			\"spr_frame\":SimpleDialog.DAVID_NORMAL_SPR,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"dialogfunc\",
			\"func\":\"clear_dialog\"
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"end_cutscene\",
			\"arg\":[]
		}
	]
	
	
	connect(\"area_entered\", func(area) : run_cutscene())

func run_cutscene():
	
	print(\"run cutscene\")
	
	SimpleDialog.set_sequence(cutscene2)
	SimpleDialog.execute_sequence(func(): get_tree().current_scene.get_node(\"radio_ambient\").set_target(-20.0))
"


[sub_resource type="GDScript" id="GDScript_afxm8"]
script/source = "extends AudioStreamPlayer

@export var target_db = -15.0
@export var init_db = -80.0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	volume_db = init_db
	set_target(target_db)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _physics_process(delta: float) -> void:
	#volume_db = lerp(volume_db, target_db, 0.05)
	volume_db = move_toward(volume_db, target_db, 1.0)

func set_target(target):
	target_db = target
"

[sub_resource type="GDScript" id="GDScript_11t3l"]
script/source = "extends Node

@onready var children = get_children()
signal play_all_instrument

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func play_all():
	for i in get_children():
		i.playing = true

func set_instrument(instru, target):
	match instru:
		\"bass\":
			$bass_music.set_target(target)
		\"drum1\":
			$drum1_music.set_target(target)
		\"half\":
			$bass_music.set_target(-15.0)
			$drum1_music.set_target(-15.0)
		\"half-2\":
			$bass_music.set_target(-25.0)
			$drum1_music.set_target(-25.0)
			$full_music.set_target(-25.0)
		\"full\":
			$bass_music.set_target(-30.0)
			$drum1_music.set_target(-30.0)
			$full_music.set_target(target)
		\"none\":
			$bass_music.set_target(-70.0)
			$drum1_music.set_target(-70.0)
			$full_music.set_target(-70.0)
"

[sub_resource type="GDScript" id="GDScript_ya84d"]
script/source = "extends AudioStreamPlayer

@export var target_db = -13.0
@export var init_db = -80.0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	volume_db = init_db
	playing = false
	set_target(target_db)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _physics_process(delta: float) -> void:
	#volume_db = lerp(volume_db, target_db, 0.1)
	volume_db = move_toward(volume_db, target_db, 1.0)

func set_target(target):
	target_db = target
"


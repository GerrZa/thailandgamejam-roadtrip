[sub_resource type="GDScript" id="GDScript_8wi4v"]
script/source = "extends Area2D

var cutscene3

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var radio_ambient = get_node(\"../../radio_ambient\")
	var music_plr = get_node(\"../../music_player\")
	
	cutscene3 = [\"1-3\",
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"start_cutscene\",
			\"arg\":[]
		},
		{
			\"type\":\"manipulate\",
			\"node\":radio_ambient,
			\"func\":\"set_target\",
			\"arg\":[-50.0]
		},
		{
			\"type\":\"manipulate\",
			\"node\":music_plr,
			\"func\":\"play_all\",
			\"arg\":[]
		},
		{
			\"type\":\"manipulate\",
			\"node\":music_plr,
			\"func\":\"set_instrument\",
			\"arg\":[\"bass\", -13.0]
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]HEY! SLOW DOWN!!![/shake]\",
			\"spr_frame\":SimpleDialog.GRACE_SHOCK,
			\"glob\":Vector2(60,160),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]I'M TRYING!!![/shake]\",
			\"spr_frame\":SimpleDialog.DAVID_SHOCK,
			\"glob\":Vector2(180,180),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[color=red][shake rate=20.0 level=5 connected=1]WATCH OUT!!![/shake]\",
			\"spr_frame\":SimpleDialog.GRACE_SHOCK,
			\"glob\":Vector2(60,120),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"dialogfunc\",
			\"func\":\"clear_dialog\"
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"end_cutscene\",
			\"arg\":[]
		}
	]
	
	
	connect(\"area_entered\", func(area) : run_cutscene())

func run_cutscene():
	
	print(\"run cutscene\")
	
	SimpleDialog.set_sequence(cutscene3)
	SimpleDialog.execute_sequence(func():
		get_tree().current_scene.get_node(\"radio_ambient\").set_target(-50.0)
		get_tree().current_scene.get_node(\"music_player\").play_all()
		get_tree().current_scene.get_node(\"music_player\").set_instrument(\"bass\", -13.0)
		)
		
"


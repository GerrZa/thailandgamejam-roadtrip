			\"spr_frame\":SimpleDialog.GRACE_SERIOUS,
			\"glob\":Vector2(60,120),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[color=Dimgray](I saw my grandma too...)[/color]\",
			\"spr_frame\":SimpleDialog.GRACE_SERIOUS,
			\"glob\":Vector2(60,120),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ #########################

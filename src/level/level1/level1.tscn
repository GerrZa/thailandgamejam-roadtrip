[sub_resource type="GDScript" id="GDScript_rl107"]
script/source = "extends Area2D

var t_scale_target = 1.0

var press_delta = 0.0
var MAX_PRESS_DELTA = 0.23
var press_dir = \"none\"

var target_fade_trans = 0.0

var active = false

var target_modulate = 0.0

func _ready() -> void:
	$button.modulate.a = 0.0
	connect(\"area_entered\", func(area):
		player_arrive()
		active = true)

func _physics_process(delta: float) -> void:
	Global.time_scale = lerp(Global.time_scale, t_scale_target, 0.1)
	
	if abs(t_scale_target - Global.time_scale) < 0.01:
		Global.time_scale = t_scale_target
	
	$fade.material.set_shader_parameter(\"fade_val\", lerp($fade.material.get_shader_parameter(\"fade_val\"), target_fade_trans, 0.1))
	
	$button.modulate.a = lerp($button.modulate.a, target_modulate, 0.05)
	$button2.modulate = $button.modulate
	
	#dash
	if active and get_tree().current_scene.get_node_or_null(\"Car\") and get_tree().current_scene.get_node_or_null(\"Car\").visible:
		if Input.is_action_just_pressed(\"ui_right\"):
			if press_dir == \"right\" and press_delta > 0.0:
				press_delta = 0.0
				get_tree().current_scene.get_node(\"Car\").force_dash(1)
				speed_back()
				active = false
				player_go()
			
			press_dir = \"right\"
			press_delta = MAX_PRESS_DELTA
		elif Input.is_action_just_pressed(\"ui_left\"):
			if press_dir == \"left\" and press_delta > 0.0:
				press_delta = 0.0
				get_tree().current_scene.get_node(\"Car\").force_dash(-1)
				speed_back()
				active = false
				player_go()
			
			press_dir = \"left\"
			press_delta = MAX_PRESS_DELTA
		
		press_delta -= delta
	
	if active and Input.is_action_just_pressed(\"ui_down\"):
		get_tree().change_scene_to_file(\"res://src/level/dead_scene/dead_scene.tscn\")

func slow_down():
	t_scale_target = 0.0
	target_fade_trans = 0.5

func speed_back():
	t_scale_target = 1.0
	target_fade_trans = 0.0

func player_go():
	var music = get_tree().current_scene.get_node(\"music_player\")
	
	target_modulate = 0.0
	
	music.set_instrument(\"bass1\", -7.0)
	music.set_instrument(\"bass\", -7.0)
	get_tree().current_scene.get_node(\"car_driving_ambient\").set_target(-15.0)
	get_tree().current_scene.get_node(\"ambient_player\").set_target(-13.0)
	
	get_tree().current_scene.get_node(\"Car\").can_dash = true

func player_arrive():
	print(\"reach\")
	slow_down()
	
	target_modulate = 1.0
	
	var music = get_tree().current_scene.get_node(\"music_player\")
	
	music.set_instrument(\"bass1\", -20.0)
	music.set_instrument(\"bass\", -20.0)
	get_tree().current_scene.get_node(\"car_driving_ambient\").set_target(-50.0)
	get_tree().current_scene.get_node(\"ambient_player\").set_target(-50.0)
"

[sub_resource type="Shader" id="Shader_11t3l"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture;

uniform vec4 base_color : source_color;
uniform vec4 exception_color[10] : source_color;
uniform int except_count = 10;

uniform float threshold : hint_range(0.0, 1.0, 0.01);

uniform float fade_val : hint_range(0.0, 1.0, 0.1) = 0.5;

void fragment() {
	for(int i = 0; i < except_count; i++){
		if(distance(texture(SCREEN_TEXTURE, SCREEN_UV), exception_color[i]) < threshold){
			COLOR = texture(SCREEN_TEXTURE, SCREEN_UV);
			break;
		}
		if (i == except_count - 1){
			COLOR = mix(texture(SCREEN_TEXTURE, SCREEN_UV), base_color, fade_val);
		}
	}
}"


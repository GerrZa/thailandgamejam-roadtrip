script/source = "extends Node2D

var moving_scale = 2.5
var moving_speed = 0.0

@export var moving = false


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	#ungroupping all moving object
	for i in $move_along.get_children():
		i.add_to_group(\"move_along\")
		i.reparent(self)
	
	#SKIPPP
	#var test_seq = [
		#{
			#\"type\":\"animation\",
			#\"animplayer\":$AnimationPlayer,
			#\"animname\":\"start\"
		#},
		#{
			#\"type\":\"dialog\",
			#\"char\":\"Boris\",
			#\"text\":\"YOOOO dialog system!!!\",
			#\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			#\"glob\":Vector2(80,80),
			#\"target\":$main_ui
		#},
		#{
			#\"type\":\"dialog\",
			#\"char\":\"Dude\",
			#\"text\":\"STFU\",
			#\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			#\"glob\":Vector2(180,120),
			#\"target\":$main_ui
		#},
		#{
			#\"type\":\"dialogfunc\",
			#\"func\":\"delete_char\",
			#\"arg\":[\"Dude\"]
		#},
		#{
			#\"type\":\"dialog\",
			#\"char\":\"Boris\",
			#\"text\":\"Fuck you\",
			#\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			#\"glob\":Vector2(80,80),
			#\"target\":$main_ui
		#},
		#{
			#\"type\":\"dialogfunc\",
			#\"func\":\"clear_dialog\"
		#},
		#{
			#\"type\":\"manipulate\",
			#\"node\":self,
			#\"func\":\"end_cutscene\",
			#\"arg\":[]
		#}
	#]
	#STOP SKIP
	
	var level1_seq1 = [
		{
			\"type\":\"animation\",
			\"animplayer\":$AnimationPlayer,
			\"animname\":\"start\"
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"Are you sure you know how to drive?\",
			\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			\"glob\":Vector2(60,120),
			\"target\":$main_ui
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"I can remember how to start a car and nothing else.\",
			\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			\"glob\":Vector2(160,140),
			\"target\":$main_ui
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[wave amp=20.0 freq=5.0 connected=1][color=Dimgray](am I gonna die today?)[/color][/wave]\",
			\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			\"glob\":Vector2(60,120),
			\"target\":$main_ui
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"Ok, so, you use your [color=blue]arrow keys[/color] to turn the car left and right.\",
			\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			\"glob\":Vector2(60,120),
			\"target\":$main_ui
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"Car's not gonna turn itself back, so don't forget to turn it back ok?\",
			\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			\"glob\":Vector2(60,120),
			\"target\":$main_ui
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"And don't drive out of the road way.\",
			\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			\"glob\":Vector2(60,120),
			\"target\":$main_ui
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"You're still new so just keep it slow and you'll be fine.\",
			\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			\"glob\":Vector2(60,120),
			\"target\":$main_ui
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"Got it.\",
			\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			\"glob\":Vector2(160,140),
			\"target\":$main_ui
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"Good.\",
			\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			\"glob\":Vector2(60,120),
			\"target\":$main_ui
		},
		{
			\"type\":\"dialogfunc\",
			\"func\":\"clear_dialog\"
		},
		{
			\"type\":\"manipulate\",
			\"node\":self,
			\"func\":\"end_cutscene\",
			\"arg\":[]
		}
	]
	
	SimpleDialog.set_sequence(level1_seq1)
	SimpleDialog.execute_sequence()

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func _physics_process(delta: float) -> void:
	
	if get_node_or_null(\"Car\"):
		moving_speed = $Car.main_speed
	else:
		moving_scale = lerp(moving_scale, 0.0, 0.03)
		$ambient_player.target_db = -80.0
		$car_driving_ambient.target_db = -80.0
	
	$bg.autoscroll = Vector2(0, moving_speed * moving_scale)
	
	if moving:
		for o in get_tree().get_nodes_in_group(\"move_along\"):
			o.position.y += moving_speed * delta * moving_scale
	
	if moving_scale < 0.01 and get_node_or_null(\"Car\") == null:
		get_tree().change_scene_to_file(\"res://src/level/dead_scene/dead_scene.tscn\")

func start_cutscene():
	print(\"start cutscene\")
	moving = false
	$Car.enable_control = false
	$Car.speed = 0.0
	$Car.apply_speed = 0.0
	$Car.disable_camera()

func end_cutscene():
	print(\"end cutscene\")
	moving = true
	$Car.enable_control = true
	$Car.enable_camera()
"


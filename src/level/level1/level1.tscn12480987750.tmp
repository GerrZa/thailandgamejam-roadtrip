[sub_resource type="GDScript" id="GDScript_rl107"]
script/source = "extends Area2D

var t_scale_target = 1.0

var press_delta = 0.0
var MAX_PRESS_DELTA = 0.15
var press_dir = \"none\"

var target_fade_trans = 0.0

var active = false

func _ready() -> void:
	connect(\"area_entered\", func(area):
		player_arrive()
		active = true)

func _physics_process(delta: float) -> void:
	Engine.time_scale = lerp(Engine.time_scale, t_scale_target, 0.1)
	
	if abs(t_scale_target - Engine.time_scale) < 0.01:
		Engine.time_scale = t_scale_target
	
	$fade.material.set_shader_parameter(\"fade_val\", lerp($fade.material.get_shader_parameter(\"fade_val\"), target_fade_trans, 0.1))
	
	#dash
	if active:
		if Input.is_action_just_pressed(\"ui_right\"):
			if press_dir == \"right\" and press_delta > 0.0:
				press_delta = 0.0
				get_tree().current_scene.get_node(\"Car\").force_dash(1)
				speed_back()
				active = false
			
			press_dir = \"right\"
			press_delta = MAX_PRESS_DELTA
		elif Input.is_action_just_pressed(\"ui_left\"):
			if press_dir == \"left\" and press_delta > 0.0:
				press_delta = 0.0
				get_tree().current_scene.get_node(\"Car\").force_dash(-1)
				speed_back()
				active = false
				
			press_dir = \"left\"
			press_delta = MAX_PRESS_DELTA
		
		press_delta -= delta

func slow_down():
	t_scale_target = 0.0
	target_fade_trans = 0.5

func speed_back():
	t_scale_target = 1.0
	target_fade_trans = 0.0

func player_arrive():
	print(\"reach\")
	slow_down()
"

[sub_resource type="Shader" id="Shader_11t3l"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture;

uniform vec4 base_color : source_color;
uniform vec4 exception_color[10] : source_color;
uniform int except_count = 10;

uniform float threshold : hint_range(0.0, 1.0, 0.01);

uniform float fade_val : hint_range(0.0, 1.0, 0.1) = 0.5;

void fragment() {
	for(int i = 0; i < except_count; i++){
		if(distance(texture(SCREEN_TEXTURE, SCREEN_UV), exception_color[i]) < threshold){
			COLOR = texture(SCREEN_TEXTURE, SCREEN_UV);
			break;
		}
		if (i == except_count - 1){
			COLOR = mix(texture(SCREEN_TEXTURE, SCREEN_UV), base_color, fade_val);
		}
	}
}"


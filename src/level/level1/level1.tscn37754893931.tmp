[sub_resource type="GDScript" id="GDScript_p7x62"]
script/source = "extends Area2D

var cutscene3

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	cutscene3 = [
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"start_cutscene\",
			\"arg\":[]
		},
		{ #########################
			\"type\":\"dialog\",
			\"char\":\"Grace\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]SLOW DOWN!!![/shake]\",
			\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			\"glob\":Vector2(60,120),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{ 
			\"type\":\"dialog\",
			\"char\":\"David\",
			\"text\":\"[shake rate=20.0 level=5 connected=1]I'M TRYING!!![/shake]\",
			\"spr_frame\":load(\"res://src/ui/simple_dialog/dialog_spriteframe/ptt_dialog_char.tres\"),
			\"glob\":Vector2(160,140),
			\"target\":get_tree().current_scene.get_node(\"main_ui\")
		},
		{
			\"type\":\"dialogfunc\",
			\"func\":\"clear_dialog\"
		},
		{
			\"type\":\"manipulate\",
			\"node\":get_tree().current_scene,
			\"func\":\"end_cutscene\",
			\"arg\":[]
		}
	]
	
	
	connect(\"area_entered\", func(area) : run_cutscene())

func run_cutscene():
	
	print(\"run cutscene\")
	
	SimpleDialog.set_sequence(cut_scene3)
	SimpleDialog.execute_sequence()
"


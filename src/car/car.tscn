[sub_resource type="GDScript" id="GDScript_tmscv"]
script/source = "extends Node2D

#var car_slice_text = preload(\"res://asset/car/car_slice.png\")
var car_slice_text = preload(\"res://asset/car/car_slice-sheet.png\")

var x_input = 0.0

var speed = 0.0
@export var apply_speed = 0.0
var acc = 9.5
var move_toward_speed = 30.0
const MAX_SPEED = 350.0

@export var main_speed = 40;
var main_speed_acc_cd = 0.0
var DEF_MAIN_SPEED_CD = 0.5

var debug_x_pos = 0.0

var press_delta = 0.0
var press_dir = \"none\"
var MAX_PRESS_DELTA = 0.15

var DEF_DASH_CD = 1.2
var dash_cd = 0.0
var dash_duration = 0.0
const DEF_DASH_DURATION = 0.2

var dash_speed = 0.0
const DEF_DASH_SPEED = 550.0
@export var can_dash = true

var car_pos = Vector2.ZERO
var car_pos_vel = Vector2.ZERO

var hp = 3

@export var debug_invin = false
@export var enable_control = true
@export var init_enable_cam = true

var invin = false

@export var left_wall = 32.0
@export var right_wall = 320-32.0

func _ready() -> void:
	#init sprite
	for i in range(13):
		var new_slice = Sprite2D.new()
		$SubViewport/car_slice.add_child(new_slice)
		
		new_slice.position.y = -i 
		new_slice.centered = true
		new_slice.texture = car_slice_text
		new_slice.hframes = 13
		new_slice.flip_v = true
		new_slice.frame = i
	
	if init_enable_cam:
		enable_camera()
	
	$soft_hit.connect(\"area_entered\", func(area): hurt(1))
	$hard_hit.connect(\"area_entered\", func(area): hurt(3))
	$boost_detect.connect(\"area_entered\", func(area):
		accelerate()
		area.remove()
		)

func _physics_process(delta: float) -> void:
	
	#car render
	car_pos += car_pos_vel * delta
	if car_pos.y < 0.0:
		car_pos_vel.y += 160 * delta
	
	$modulate_control/car_render.position = car_pos
	car_pos.y = clamp(car_pos.y, -INF, 0.0)
	
	$modulate_control/car_render.scale = lerp($modulate_control/car_render.scale, Vector2(1,1), 0.1)
	$modulate_control/car_render.material.set_shader_parameter(\"progress\", clamp(dash_cd/DEF_DASH_CD, 0.0, 1.0))
	
	#acceleration (move into a trigger only function)
	#if Input.is_action_just_pressed(\"ui_up\"):
		#main_speed += 20
		#DEF_DASH_CD *= 0.95
		#acc += 0.5
		#acc = clamp(acc, 0.0, 18.0)
		#$modulate_control/car_render.scale = Vector2(0.8, 1.2)
		#$camera_control.zoomin(clamp(1 + 0.01 * ((main_speed-20) / 20), 0.0, 1.3))
		#
		#main_speed_acc_cd = DEF_MAIN_SPEED_CD
	#
	#main_speed_acc_cd -= delta
	
	#dash
	if Input.is_action_just_pressed(\"ui_right\") and Input.is_action_pressed(\"ui_left\") == false and enable_control:
		if press_dir == \"right\" and press_delta > 0.0 and dash_cd < 0.0:
			press_delta = 0.0
			#dash_cd = DEF_DASH_CD
			dash()
		
		press_dir = \"right\"
		press_delta = MAX_PRESS_DELTA
	elif Input.is_action_just_pressed(\"ui_left\") and Input.is_action_pressed(\"ui_right\") == false and enable_control:
		if press_dir == \"left\" and press_delta > 0.0 and dash_cd < 0.0:
			press_delta = 0.0
			#dash_cd = DEF_DASH_CD
			dash()
			
		press_dir = \"left\"
		press_delta = MAX_PRESS_DELTA
	
	press_delta -= delta
	dash_cd -= delta * Global.time_scale
	
	#moving input
	var new_acc = acc
	if abs(apply_speed) > 150.0 and sign(apply_speed) == sign(x_input):
		new_acc/=2
		if abs(apply_speed) > 175.0:
			new_acc/=2
	
	if enable_control:
		x_input = Input.get_axis(\"ui_left\", \"ui_right\")
		speed += x_input * new_acc * Global.time_scale
	
	if sign(apply_speed) != sign(x_input) and abs(apply_speed) > 50.0 and sign(x_input) != 0:
		$car_turn_sfx.set_target((8 * clamp((abs(apply_speed) -50.0) / (200.0 - 50.0), 0.0, 1.5)))
	else:
		$car_turn_sfx.set_target(-80.0)
	
	speed = clamp(speed, -MAX_SPEED, MAX_SPEED)
	if dash_duration > 0.0:
		apply_speed = lerp(apply_speed, speed, 0.1)
	else:
		if enable_control:
			apply_speed = speed
	
	position.x += apply_speed * delta * Global.time_scale
	
	if x_input == 0:
		speed = lerp(speed, 0.0, 0.0125 + (0.025 * abs(speed) / MAX_SPEED) * Global.time_scale)
	
	dash_duration -= delta * Global.time_scale
	debug_x_pos = position.x
	
	#wall detect
	if debug_invin == false:
		if position.x <= left_wall and apply_speed < 0.0 and invin == false:
			hurt(1)
			speed = MAX_SPEED / 3
		elif position.x >= right_wall and apply_speed >= 0.0 and invin == false:
			hurt(1)
			speed = -MAX_SPEED / 3
	
	position.x = clamp(position.x, left_wall, right_wall)
	
	print(apply_speed)
	
	#rotate car
	for s in $SubViewport/car_slice.get_children():
		s.rotation_degrees = lerp(s.rotation_degrees, (90 * 0.75) * (apply_speed / MAX_SPEED), 0.4 * Global.time_scale)
	$soft_hit.rotation_degrees = lerp($soft_hit.rotation_degrees, (90 * 0.75) * (apply_speed / MAX_SPEED), 0.4 * Global.time_scale)
	$hard_hit.rotation_degrees = lerp($hard_hit.rotation_degrees, (90 * 0.75) * (apply_speed / MAX_SPEED), 0.4 * Global.time_scale)
	
	if Input.is_action_pressed(\"ui_up\") and enable_control:
		#$car_hoot_sfx.set_target(0.0)
		$car_hoot_sfx.volume_db = lerp($car_hoot_sfx.volume_db, 0.0, 0.5)
		$modulate_control/car_render.scale = Vector2(1.25,0.8)
		$HootingIcon.modulate.a = lerp($HootingIcon.modulate.a, 1.0, 0.5)
	else:
		#$car_hoot_sfx.set_target(-80.0)
		$car_hoot_sfx.volume_db = lerp($car_hoot_sfx.volume_db, -80.0, 0.5)
		$HootingIcon.modulate.a = lerp($HootingIcon.modulate.a, 0.0, 0.1)
	
	if Input.is_action_just_pressed(\"ui_down\") and enable_control:
		hurt(3)

func dash():
	if can_dash == false:
		return
	
	$modulate_control/car_render.scale = Vector2(1.4,0.8)
	$car_dash_sfx.play()
	
	match press_dir:
		\"right\":
			speed = abs(speed)
			apply_speed = DEF_DASH_SPEED
			dash_duration = DEF_DASH_DURATION
		\"left\":
			speed = -abs(speed)
			apply_speed = -DEF_DASH_SPEED
			dash_duration = DEF_DASH_DURATION
	
	dash_cd = DEF_DASH_CD
	press_dir = \"none\"

func force_dash(dir):
	speed = dir * abs(speed)
	apply_speed = dir * DEF_DASH_SPEED * 2
	dash_cd = DEF_DASH_CD
	dash_duration = DEF_DASH_DURATION
	$car_dash_sfx.play()

func accelerate():
	main_speed += 15
	DEF_DASH_CD *= 0.95
	#acc += 0.1
	acc = clamp(acc, 0.0, 18.0)
	$modulate_control/car_render.scale = Vector2(0.8, 1.2)
	$camera_control.zoomin(clamp(1 + 0.01 * ((main_speed-20) / 20), 0.0, 1.3))
	
	$acc_sfx.play()
	$boost_hit_sfx.play()
	$boost_bass_sfx.play()

func hurt(damage):
	if debug_invin:
		return
	
	print(\"hurt\")
	
	if invin == false or damage >= 3:
		$camera_control.shake()
		hp -= damage
		
		$car_damage_sfx.play()
		
		if hp <= 0:
			dead()
			get_tree().current_scene.get_node(\"Camera2D\").enabled = true
			get_tree().current_scene.get_node(\"Camera2D\").shake()
			$car_damage_sfx.reparent(get_tree().current_scene)
			print(\"ded\")
			return
		
		invin = true
		$modulate_control/car_render/AnimationPlayer.play(\"blink\")
		await $modulate_control/car_render/AnimationPlayer.animation_finished
		invin = false

func dead():
	var ded_part = load(\"res://src/particle/explosion_part.tscn\")
	var part_ins = ded_part.instantiate()
	
	get_tree().current_scene.add_child(part_ins)
	part_ins.global_position = global_position
	
	queue_free()

func enable_camera():
	$camera_control/Camera2D.enabled = true
	get_tree().current_scene.get_node(\"Camera2D\").enabled = false

func disable_camera():
	$camera_control/Camera2D.enabled = false
	get_tree().current_scene.get_node(\"Camera2D\").enabled = true
"


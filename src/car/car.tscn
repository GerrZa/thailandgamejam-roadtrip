[sub_resource type="GDScript" id="GDScript_tf5ac"]
script/source = "extends Marker2D

var y_off = 0.0
var y_off_move = 0.0

var def_y_off = 0.0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	def_y_off = position.y

func _physics_process(delta: float) -> void:
	position.y = def_y_off + y_off
	
	y_off_move -= 64 * delta
	y_off += y_off_move
	
	y_off = clamp(y_off, 0.0, INF)

func shake():
	$Camera2D.shake()

func zoomin(target):
	$Camera2D.zoomin(target)
"

[sub_resource type="GDScript" id="GDScript_gevnm"]
script/source = "extends AudioStreamPlayer

@export var target_db = -80.0

func _physics_process(delta: float) -> void:
	volume_db = lerp(volume_db, target_db, 0.5)

func set_target(target):
	target_db = target
"


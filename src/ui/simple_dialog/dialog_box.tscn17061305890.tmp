[sub_resource type="GDScript" id="GDScript_gj2nl"]
script/source = "extends Node2D

var fin_box_size = Vector2(80, 57)

var box_anim_finish = false
var text_anim_finish = false
var text = \"Test\"
var char_name = \"JOHN\"

var float_vis_char = 0.0

@export_enum(\"None\", \"test\") var when_finish_func : String

func _ready() -> void:
	print(when_finish_func)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"ui_accept\"):
		if text_anim_finish == false:
			skip_animation()
		else:
			new_dialog(\"[wave amp=40.0 freq=10.0 connected=0]HEY![/wave]\")

func _physics_process(delta: float) -> void:
	$dialog_box.size = lerp($dialog_box.size, fin_box_size, 0.1)
	$dialog_box.position.y = -$dialog_box.size.y
	$char.position.y = $dialog_box.position.y
	$char_name.position = $dialog_box.position + Vector2(14,-3)
	
	if abs(fin_box_size.y - $dialog_box.size.y) < 0.1 and box_anim_finish == false:
		$dialog_box.size = fin_box_size
		box_anim_finish = true
	
	if box_anim_finish and text_anim_finish == false:
		float_vis_char += 0.5
		$dialog_box/RichTextLabel.visible_characters = ceil(float_vis_char)
		$char.play(\"say\")
	
	if $dialog_box/RichTextLabel.visible_ratio >= 1.0:
		text_anim_finish = true
		$char.play(\"shut\")
		
	print($dialog_box/RichTextLabel.visible_characters)
	#print(\"box anim: \" + var_to_str(box_anim_finish))
	#print(\"text anim: \" + var_to_str(text_anim_finish))
	#print(\"diff\" + var_to_str(fin_box_size.y - $dialog_box.size.y))

func skip_animation():
	$dialog_box.size = fin_box_size
	$dialog_box/RichTextLabel.visible_ratio = 1.0
	
	box_anim_finish = true
	text_anim_finish = true

func new_dialog(text := \"no text\"):
	$dialog_box/RichTextLabel.text = text
	$dialog_box/RichTextLabel.visible_characters = 0.0
	text_anim_finish = false

func init(new_charname, new_text, char_spr : SpriteFrames):
	text = new_text
	char_name = new_charname
	
	$dialog_box.size.y = 8
	$dialog_box.position.y = -8
	$char_name.text = char_name
	$dialog_box/RichTextLabel.text = text
	$char.sprite_frames = char_spr
	$char.play(\"shut\")
	$char.frame = 0
	
	$dialog_box/RichTextLabel.visible_ratio = 0
"

[sub_resource type="Shader" id="Shader_gj2nl"]
code = "shader_type canvas_item;

uniform float width;
uniform float height;

uniform vec4 outlineColor : source_color;

void vertex() {
	// Called for every vertex the material is visible on.
}

void fragment() {
	float pixelSizeX = 1.0 / width;
	float pixelSizeY = 1.0 / height;

	if (texture(TEXTURE, UV + vec2(-pixelSizeX, 0.0)).a > 0.0 || texture(TEXTURE, UV + vec2(0.0, -pixelSizeY)).a > 0.0){
		if (COLOR.a < 0.5){
			COLOR = outlineColor;
		}
	}
}

//void light() {
//	// Called for every pixel for every light affecting the CanvasItem.
//	// Uncomment to replace the default light processing function with this one.
//}
"

